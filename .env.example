# Copy to .env and fill in. .env is gitignored; .env.example is not, so no
# real secret belongs in this file.
#
#   cp .env.example .env

# ---------------------------------------------------------------------- VoCat

# VoCat does not store administrator credentials here. Initialise a new Docker
# database with the bootstrap-admin command documented at the top of
# docker-compose.yml; the admin password lives only in SQLite.

# Host port for the web UI.
#VOCAT_PORT=7676

# Go module proxy, for networks that cannot reach proxy.golang.org.
#GOPROXY=https://goproxy.cn,direct

# ------------------------------------- Asterisk (docker-compose.asterisk.yml)

# Uncomment to make every `docker compose` command in this directory load the
# Asterisk overlay too, without repeating -f flags. scripts/docker-build.sh
# picks this up as well.
#COMPOSE_FILE=docker-compose.yml:docker-compose.asterisk.yml

# Softphone password. Required, minimum 12 characters -- the entrypoint
# refuses to start otherwise. Replace the value on the line below; do not
# append a second ASTERISK_SIP_PASSWORD line, because which of two wins is a
# Compose precedence rule rather than anything you can see in the file.
# Generate one rather than choosing one:
#   openssl rand -base64 24
ASTERISK_SIP_PASSWORD=

# Softphone extension number.
#ASTERISK_SIP_USER=1001

# Which SIM places outbound calls, by device ID or device name. Leave empty
# while only one device is IMS-registered: VoCat picks it. Once a second one
# registers VoCat refuses to guess, because guessing would place a real,
# billed call on whichever sorted first -- set this then.
#VOCAT_DEVICE=SLOT1-1

# Where Asterisk finds VoCat's trunk. Must match VOCAT_SIP_TRUNK_ADDR.
#VOCAT_TRUNK_HOST=127.0.0.1:5062
